generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id          Int      @id @default(autoincrement())
  externalId  String?
  source      String
  title       String
  company     String?
  location    String?
  description String?
  url         String
  publishedAt DateTime?

  experienceMin Int?
  experienceMax Int?
  seniority     String?
  roleType      String?
  remoteType    String?

  rawData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@unique([source, url])
  @@index([source])
  @@index([title])
  @@index([publishedAt])
  @@index([seniority])
  @@index([roleType])
}